  {"name": "PC_memorise", "kind": "train"},
  {"name": "P3_e1_dev", "kind": "rows_eval", "source": "P3_seed0", "snapshot": 1, "after": ["B0_base_dev", "P3_seed0"]},
  {"name": "P3_e2_dev", "kind": "rows_eval", "source": "P3_seed0", "snapshot": 2, "after": ["B0_base_dev", "P3_seed0"]},
  {"name": "P3_e3_dev", "kind": "rows_eval", "source": "P3_seed0", "snapshot": "final",
   "after": ["B0_base_dev", "P3_seed0"]},
  {"name": "REG2", "kind": "reg2", "after": ["P3_seed0", "S1_seed1", "PC_memorise"], "optional_after": ["PC_memorise"],
   "conditions": [{"label": "P3_e1", "source": "P3_seed0", "snapshot": 1},
                  {"label": "P3_e3", "source": "P3_seed0", "snapshot": "final"},
                  {"label": "S1_seed1", "source": "S1_seed1", "snapshot": "final"},
                  {"label": "PC", "source": "PC_memorise", "snapshot": "final", "positive_control": true}]},
  {"name": "Z_report", "kind": "m1d_report", "counts": "C0_countgrid", "reg": "REG2", "p3_train": "P3_seed0",
   "arms": {"P3_e1": "P3_e1_dev", "P3_e2": "P3_e2_dev", "P3_e3": "P3_e3_dev", "S1_seed1": "S1_seed1",
            "R01_rho0p1": "R01_rho0p1", "DF_distill": "DF_distill"},
   "rules": {
    "epochs": {"passes": [1, 2, 3], "min_gain_pts": 0.1, "max_share_increase": 0.05,
               "text": "epochs for M2 = the smallest k in {1, 2} such that pass k+1 adds < 0.1 points of dev Bar-A diff over pass k, or raises P3's own retention share (X alone) by > 0.05, or takes P3 alone outside the retention bars, or has no lambda_X; else 3 (reported as still gaining when pass 3 added >= 0.1)"},
    "rho": {"small": 0.1, "large": 0.3, "tie_pts": 0.1,
            "text": "rho for M2 = 0.1 if R01's dev Bar-A diff >= P3 pass 1's - 0.1 points (within 0.1 points, or better); else 0.3"},
    "distill": {"text": "distill kept for M2 only if DF's dev Bar-A diff >= P3 pass 1's (no lambda_X counts as below)"},
    "replicate": {"text": "report |S1_seed1 - P3 pass 1| for dev E1 and dev Bar-A diff, and whether S1_seed1 holds both dev bars (Bar A and Bar B); if not, M1c's PASS is flagged fragile"}
   },
   "after": ["C0_countgrid", "P3_e1_dev", "P3_e2_dev", "P3_e3_dev", "S1_seed1", "R01_rho0p1", "DF_distill", "REG2"],
   "optional_after": ["REG2"]}
 ],
