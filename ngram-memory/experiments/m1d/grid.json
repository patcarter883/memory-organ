  "DF_distill": {"objective": "distill", "note": "one pass, Stage-1b distillation (alpha 1), teacher targets for all 310 windows"},
  "PC_memorise": {"train_windows": "canary", "pc_window": 512, "pc_after": 32, "anchors": false, "lr": 0.1,
