  "N3_rho0p3": {"rho": 0.3, "note": "next-token at rho 0.3"},
  "D1_distill_rho0p03": {"rho": 0.03, "objective": "distill",
                         "note": "Stage-1b: KL(teacher || student), teacher = host with 4096 BM25-retrieved tokens of other train files before the window"},
  "D2_distill_rho0p1": {"rho": 0.1, "objective": "distill", "note": "Stage-1b at rho 0.1"},
  "F1_fullpass": {"from_selection": {"*": "S1_select"}, "steps": "epoch",
                  "note": "S1's recipe retrained for one full pass over the 310 train windows (distill: teacher targets for every window)"}
 },
 "arm_extra_conditions": ["countgrid:kn+{rows}"],
 "base_stage": "B0_base_dev",
 "dev_sets": "dev,r1,r2,r2ml",
 "stages": [
  {"name": "B0_base_dev", "kind": "base", "sets": "dev,r1,r2,r2ml"},
  {"name": "D1_distill_rho0p03", "kind": "train_eval", "after": ["B0_base_dev"]},
  {"name": "N1_rho0p03", "kind": "train_eval", "after": ["B0_base_dev"]},
  {"name": "N2_rho0p1", "kind": "train_eval", "after": ["B0_base_dev"]},
  {"name": "N3_rho0p3", "kind": "train_eval", "after": ["B0_base_dev"]},
  {"name": "D2_distill_rho0p1", "kind": "train_eval", "after": ["B0_base_dev"]},
  {"name": "C0_countgrid", "kind": "countgrid", "conditions": "countgrid:kn", "label": "countgrid[kn]",
   "after": ["B0_base_dev"]},
  {"name": "S1_select", "kind": "m1c_select", "counts": "C0_countgrid",
   "candidates": ["N1_rho0p03", "N2_rho0p1", "N3_rho0p3", "D1_distill_rho0p03", "D2_distill_rho0p1"],
   "after": ["C0_countgrid", "N1_rho0p03", "N2_rho0p1", "N3_rho0p3", "D1_distill_rho0p03", "D2_distill_rho0p1"]},
  {"name": "F1_fullpass", "kind": "train_eval", "after": ["S1_select"]},
  {"name": "OP_select", "kind": "m1c_op", "s1": "S1_select", "f1": "F1_fullpass", "counts": "C0_countgrid",
   "after": ["S1_select", "F1_fullpass"]},
  {"name": "T_test", "kind": "m1c_test", "operating_point": "OP_select", "after": ["OP_select"],
   "conditions": ["base", "op", "countlm_lstar", "countlm_lstar+op", "countlm_matched_op", "perm_op"]},
  {"name": "REG_op", "kind": "reg", "operating_point": "OP_select", "after": ["OP_select"]},
  {"name": "Z_report", "kind": "m1c_report", "select": "S1_select", "operating_point": "OP_select",
   "test": "T_test", "reg": "REG_op", "after": ["T_test", "REG_op"]}
 ],
 "budgets": {
  "full": {"steps": 64, "window": 4096, "stride": 3584, "anchor_window": 1024, "anchor_windows": 24, "topk": 64,
           "reference_tokens": 500000, "ckpt_every": 4, "monitor_dev_windows": 2},
