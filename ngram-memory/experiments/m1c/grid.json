                   "lambda_l2", "lambda_rho", "gamma", "pi_other", "objective", "distill_alpha", "teacher_ctx_tokens",
                   "canaries"],
 "arms": {
  "N1_rho0p03": {"rho": 0.03, "note": "next-token at rho 0.03: M1b's operating point (A3) retrained here with canaries"},
